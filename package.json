{
  "name": "kisan-setu",
  "version": "1.0.0",
  "private": true,
  "description": "Kisan Setu — Smart Digital Procurement & Queue Management System for Farmers",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "start": "node server/server.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "tunnel": "node scripts/tunnel.js",
    "bg:start": "bash scripts/start-bg.sh",
    "bg:stop": "bash scripts/stop-bg.sh",
    "bg:status": "bash scripts/status-bg.sh",
    "bg:logs": "npx pm2 logs kisan-setu",
    "push": "bash scripts/push-to-github.sh"
  },
  "keywords": [
    "kisan-setu",
    "smart-india-hackathon",
    "agriculture",
    "queue-management",
    "procurement"
  ],
  "author": "Team White Raven (GBPIET)",
  "license": "MIT",
  "devDependencies": {
    "pm2": "^5.4.3"
  }
}
